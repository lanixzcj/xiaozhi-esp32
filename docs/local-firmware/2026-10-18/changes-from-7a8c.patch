+#pragma once
+#include "animal_find_session.h"
+#include "animal_game_sounds.h"
+#include "animal_find_speech.h"
+
+namespace animal_find_audio {
+// Questions and replays use the same real recording as free touch playback.
+inline std::string_view Clip(AnimalFindSession::Stage stage, size_t target, size_t chosen) {
+    switch (stage) {
+        case AnimalFindSession::Stage::Question:
+        case AnimalFindSession::Stage::Call:
+            return animal_game_assets::GetSound(target);
+        case AnimalFindSession::Stage::Praise:
+            return animal_find_speech::Praise();
+        case AnimalFindSession::Stage::Identify:
+            return animal_find_speech::Identify(chosen);
+        default:
+            return {};
+    }
+}
+}  // namespace animal_find_audio
